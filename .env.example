# ALTAR-NASA: Flame in Freefall — Yapay Zeka ve Veri Yapılandırma Şablonu
# Not: API anahtarlarınızı doğrudan Web Paneli içindeki "🔑 API & Motor Ayarları"
# penceresinden de güvenle kaydedebilirsiniz (%APPDATA%\AltarNasa\config.json).
# ============================================================================

# 1. Google Gemini / Google AI Studio API Anahtarı (Önerilen Bulut Motoru)
GEMINI_API_KEY=""

# 2. OpenRouter API Anahtarı (Alternatif Bulut Motoru)
OPENROUTER_API_KEY=""

# 3. Google Antigravity / Özel OpenAI-Uyumlu Ağ Geçidi (İsteğe Bağlı)
ANTIGRAVITY_API_KEY=""
CUSTOM_OPENAI_BASE_URL=""

# 4. Yerel Ollama Sunucu Adresi (Derin Uzay Çevrimdışı Otonom Modu)
OLLAMA_HOST="http://127.0.0.1:11434"
